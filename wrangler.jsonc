{
"vars": {
  "GOOGLE_PHOTOS_CLIENT_ID": "77157551547-40rja7lndsgvac755flqehrlfg6ioqqk.apps.googleusercontent.com"
},
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyducati",
  "main": "worker/auth.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth",
      "/auth/*",
      "/api/media",
      "/api/google-photos/*",
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nyducati-media"
    }
  ]
}
