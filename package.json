    "media:estimate": "node scripts/media-cost.mjs"
  },
  "dependencies": {
    "astro": "7.4.1",
    "decap-cms": "3.17.1",
    "heic-to": "1.6.6",
    "js-yaml": "5.5.0",
    "marked": "17.0.6",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "turndown": "7.2.4"
  }
