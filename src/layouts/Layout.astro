---
import config from '../../site.config.json';
import {hiddenPaths as hiddenPostPaths} from '../lib/posts.js';
import {hiddenJourneyPaths} from '../lib/journeys.js';
const hiddenPaths=[...hiddenPostPaths,...hiddenJourneyPaths];
const fontUrl=config.branding?.logoWebfontUrl;
const {overlayHeader=true}=Astro.props;
const {title=config.title, description='Motorcycle stories and photography by Tigh Loughhead.', canonical, socialImage, article} = Astro.props;
const absolute = path => path?.startsWith('https://') ? path : 'https://www.nyducati.com'+path;
const schema = article ? {'@context':'https://schema.org','@type':article.kind==='page'?'WebPage':'BlogPosting',headline:article.title,description:description,url:absolute(canonical),author:{'@type':'Person',name:article.author||'Tigh Loughhead'},...(article.publishedAt?{datePublished:article.publishedAt}:{}),...(article.history?.updatedAt?{dateModified:article.history.updatedAt}:{}),...(socialImage?{image:absolute(socialImage)}:{}),keywords:(article.tags||[]).join(', ')} : null;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={!config.indexingEnabled||article?.seo?.noindex||Astro.props.pageNoindex?'noindex,nofollow':'index,follow'}/><meta name="description" content={description}/><title>{title} — NYDUCATI</title>{canonical && <link rel="canonical" href={'https://www.nyducati.com'+canonical}/>}
<link rel="alternate" type="application/rss+xml" title="NYDUCATI RSS" href="/rss.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?.kind==='post'?'article':'website'}/>{canonical&&<meta property="og:url" content={absolute(canonical)}/>}<meta name="twitter:card" content={socialImage?'summary_large_image':'summary'}/>{socialImage&&<meta property="og:image" content={absolute(socialImage)}/>}<script is:inline type="application/ld+json" set:html={schema?JSON.stringify(schema).replace(/</g,'\\u003c'):null}/><link rel="stylesheet" href="/style.css"/>{fontUrl && <style set:html={`@font-face{font-family:'Reflex Pro Regular';src:url('${fontUrl}');font-weight:400;font-style:normal;font-display:swap}.wordmark.logo-type{font-family:'Reflex Pro Regular',sans-serif;font-weight:400;font-size:38px;line-height:1;letter-spacing:0;width:auto}`}/>}</head>
<body class:list={[{"has-photo-header":overlayHeader}]}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><a href="/" class:list={["wordmark",{"logo-type":!!fontUrl}]} aria-label="NYDucati home">{fontUrl ? "NYDUCATI" : <img src={config.branding.logoImage} alt="NYDUCATI" width="704" height="114"/>}</a><nav aria-label="Main navigation">{config.navigation.filter(n=>n.visible!==false&&!hiddenPaths.includes(n.href)).map(n=>n.children?.some(c=>c.visible!==false&&!hiddenPaths.includes(c.href))?<details class="menu-group"><summary>{n.label}</summary><div class="submenu"><a href={n.href}>{n.label}</a>{n.children.filter(c=>c.visible!==false&&!hiddenPaths.includes(c.href)).map(c=><a href={c.href}>{c.label}</a>)}</div></details>:<a href={n.href}>{n.label}<span aria-hidden="true"> ↗</span></a>)}</nav><form class="header-search" action="/search/" role="search"><label class="sr-only" for="header-query">Search NYDUCATI</label><input id="header-query" name="q" type="search" placeholder="Search stories…" required maxlength="200"/><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button></form></header>
<main id="main"><slot/></main>
<footer><a class:list={["wordmark",{"logo-type":!!fontUrl}]} href="/">{fontUrl ? "NYDUCATI" : <img src={config.branding.logoImage} alt="NYDUCATI" width="704" height="114"/>}</a><p>Stories from the saddle.<br/>Words & photography by Tigh Loughhead.</p><a href="https://www.nyducati.com/">Visit the original archive ↗</a><small>Preview · selected archive content<br/>Full archive migration is in progress.</small></footer>
<dialog id="lightbox"><button class="close-lightbox" aria-label="Close photograph">Close ×</button><img alt=""/><p></p></dialog>
<script>
const header=document.querySelector<HTMLElement>('.site-header');
const updateHeader=()=>header?.classList.toggle('is-scrolled',window.scrollY>32);
updateHeader();
window.addEventListener('scroll',updateHeader,{passive:true});
window.addEventListener('pageshow',updateHeader);
const dialog=document.querySelector<HTMLDialogElement>('#lightbox');
document.querySelectorAll<HTMLImageElement>('.prose img').forEach(img=>{
 const link=img.closest('a'); if(!link)return;
 link.addEventListener('click',e=>{e.preventDefault();const full=dialog!.querySelector('img')!;full.src=link.href;full.alt=img.alt;dialog!.showModal();});
});
dialog?.querySelector('button')?.addEventListener('click',()=>dialog.close());
dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
</script>
</body></html>
